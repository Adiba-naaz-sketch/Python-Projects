   "source": [
    "import random\n",
    "import string\n",
    "\n",
    "password = ''.join(\n",
    "   random.choice(\n",
    "       string.ascii_letters + string.digits\n",
    "   ) for i in range(5)\n",
    ")\n",
    "\n",
    "print(password)"
   ]
